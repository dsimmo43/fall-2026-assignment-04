erDiagram
    USERS ||--o| BORROWERS : "registers_as"
    AUTHORS ||--o{ BOOKS : "writes"
    GENRES ||--o{ BOOKS : "classifies"
    BORROWERS ||--o{ LOANS : "initiates"
    BOOKS ||--o{ LOANS : "is_lent_via"

    USERS {
        serial id PK
        varchar email
        varchar name
        timestamp created_at
    }

    BORROWERS {
        serial id PK
        integer user_id FK
        varchar membership_number
        varchar phone
        timestamp created_at
    }

    AUTHORS {
        serial id PK
        varchar name
        text bio
        timestamp created_at
    }

    GENRES {
        serial id PK
        varchar name
        text description
        timestamp created_at
    }

    BOOKS {
        serial id PK
        varchar title
        varchar isbn
        integer author_id FK
        integer genre_id FK
        integer total_copies
        integer available_copies
        timestamp created_at
    }

    LOANS {
        serial id PK
        integer book_id FK
        integer borrower_id FK
        timestamp loan_date
        timestamp due_date
        timestamp return_date
        varchar status
    }
